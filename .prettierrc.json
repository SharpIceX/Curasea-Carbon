{
	"semi": true,
	"tabWidth": 4,
	"useTabs": true,
	"endOfLine": "lf",
	"printWidth": 120,
	"singleQuote": true,
	"bracketSpacing": true,
	"jsxSingleQuote": true,
	"trailingComma": "all",
	"arrowParens": "always",
	"bracketSameLine": true,
	"proseWrap": "preserve",
	"objectWrap": "preserve",
	"checkIgnorePragma": true,
	"quoteProps": "as-needed",
	"singleAttributePerLine": false,
	"vueIndentScriptAndStyle": false,
	"embeddedLanguageFormatting": "auto",
	"htmlWhitespaceSensitivity": "strict",
	"plugins": ["prettier-plugin-sql"],
	"overrides": [
		{
			"files": ["*.md", "*.yml", "*.yaml"],
			"options": {
				"tabWidth": 2,
				"useTabs": false
			}
		},
		{
			"files": ["*.sql"],
			"options": {
				"sqlFormatter": {
					"tabWidth": 4,
					"useTabs": true,
					"expressionWidth": 80,
					"keywordCase": "upper",
					"dataTypeCase": "lower",
					"denseOperators": false,
					"linesBetweenQueries": 2,
					"language": "postgresql",
					"indentStyle": "standard",
					"functionCase": "preserve",
					"identifierCase": "preserve",
					"newlineBeforeSemicolon": false,
					"logicalOperatorNewline": "before",
					"paramTypes": "{\"numbered\":[\"$\"]}"
				}
			}
		}
	]
}
